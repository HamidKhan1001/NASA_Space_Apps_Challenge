server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    gzip on;
    gzip_types text/css application/javascript application/json application/geo+json text/markdown image/svg+xml;
    gzip_min_length 1024;

    # data files change weekly; let a phone reuse them for five minutes
    location /data/ { add_header Cache-Control "public, max-age=300, must-revalidate"; }
    location /js/   { add_header Cache-Control "public, max-age=3600"; }
    location /css/  { add_header Cache-Control "public, max-age=3600"; }

    # tidy URLs
    location = /guide   { try_files /guide.html =404; }
    location = /methods { try_files /methods.html =404; }

    location / { try_files $uri $uri/ /index.html; }

    add_header X-Content-Type-Options nosniff always;
}
